# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). Apply
# supabase/migrations/0001_supports.sql to that project before running the
# app — the support form and globe have nothing to read/write without it.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
